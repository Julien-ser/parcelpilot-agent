# ---------------------------------------------------------------------------
# Model provider. Set ONE of these. They are tried in this order.
# ---------------------------------------------------------------------------

# Google AI Studio - free tier, no card required: https://aistudio.google.com/apikey
# Recommended for a hosted demo: the free daily limit survives real usage.
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-3.6-flash

# Groq - free tier, no card required: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter - note the free tier is capped at 50 requests/day with no credit
# balance, which a deployed demo will exhaust quickly.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ---------------------------------------------------------------------------
# HMAC key for action confirmation tokens. Generate with: openssl rand -hex 16
# ---------------------------------------------------------------------------
ACTION_SIGNING_SECRET=change-me
