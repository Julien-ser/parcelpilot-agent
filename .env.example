# OpenRouter API key. The account must have credits: the free tier is capped at
# 50 requests/day and paid models return HTTP 402 without a balance.
OPENROUTER_API_KEY=sk-or-v1-...

# Any tool-calling model. Claude Haiku 4.5 is a good cost/quality point for this workload.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# HMAC key for action confirmation tokens. Generate with: openssl rand -hex 16
ACTION_SIGNING_SECRET=change-me
